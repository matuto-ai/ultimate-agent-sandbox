      },
      "resources": {
        "cpu": 2,
        "memory_bytes": 2147483648,
        "disk_bytes": 10737418240,
        "pids": 256,
        "log_bytes": 10485760
      },
      "profiles": [
        {
          "id": "worker",
          "instructions": "Implement only authorized work; a tool declaration grants no authority.",
          "tools": [
